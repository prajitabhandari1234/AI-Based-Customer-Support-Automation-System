@startuml
title AI-Based Customer Support Automation System - Class Diagram

' ======================
' Core domain classes
' ======================

class User {
  +Long userId
  +String name
  +String email
  +String passwordHash
  +UserRole role        ' CLIENT, AGENT, ADMIN
  +String status        ' Active / Inactive
  +Date createdAt
}

enum UserRole {
  CLIENT
  AGENT
  ADMIN
}

class Ticket {
  +Long ticketId
  +Long customerId          ' FK -> User (Client)
  +Long assignedAgentId     ' FK -> User (Agent), optional
  +String category          ' Billing, Technical, Account, General, etc.
  +String priority          ' Low, Medium, High, Critical
  +String status            ' Open, In Progress, Resolved, On Hold
  +Double sentimentScore
  +Double aiConfidenceScore
  +Date createdAt
  +Date updatedAt
}

class Message {
  +Long messageId
  +Long ticketId
  +SenderType senderType
  +Long senderUserId
  +String content
  +Double sentimentScore
  +Date timestamp
}

enum SenderType {
  CLIENT
  AI
  AGENT
}

class KnowledgeBaseEntry {
  +Long kbId
  +String questionPattern
  +String answerTemplate
  +String category
  +Long lastUpdatedBy
  +Date lastUpdatedAt
}

' ======================
' Logging classes
' ======================

class SystemLog {
  +Long logId
  +String eventType
  +String description
  +Date timestamp
  +Long userId
  +Long ticketId
}

class SystemLogService {
  +recordEvent(eventType : String, description : String, userId : Long, ticketId : Long) : void
  +getLogsByUser(userId : Long) : List<SystemLog>
  +getLogsByTicket(ticketId : Long) : List<SystemLog>
}

' ======================
' NEW: Notification Service
' ======================

class NotificationService {
  +notifyAgent(agentId : Long, ticketId : Long, message : String) : void
  +notifyAdmin(adminId : Long, message : String) : void
  +notifyClient(clientId : Long, message : String) : void
}

' ======================
' Service / logic classes
' ======================

class AuthService {
  +login(email : String, password : String) : User
  +register(userData : User) : User
  +assignRole(userId : Long, role : UserRole) : void
}

class ChatbotService {
  +processMessage(client : User, messageContent : String) : Message
  +generateResponse(ticket : Ticket, kbEntry : KnowledgeBaseEntry) : String
  +analyseSentiment(messageContent : String) : Double
  +computeConfidence(messageContent : String) : Double
}

class TicketService {
  +createTicket(customer : User, initialMessage : Message) : Ticket
  +classifyTicket(ticket : Ticket) : void
  +prioritiseTicket(ticket : Ticket) : void
  +assignToAgent(ticket : Ticket, agent : User) : void
  +updateStatus(ticketId : Long, status : String) : void
}

class KnowledgeBaseService {
  +addEntry(entryData : KnowledgeBaseEntry) : KnowledgeBaseEntry
  +updateEntry(kbId : Long, entryData : KnowledgeBaseEntry) : KnowledgeBaseEntry
  +deleteEntry(kbId : Long) : void
  +findMatchingEntry(messageContent : String) : KnowledgeBaseEntry
}

class AnalyticsService {
  +getTicketStatistics() : TicketStatistics
  +getSentimentTrends() : SentimentReport
  +getChatbotPerformance() : ChatbotReport
}

class TicketStatistics {
  +int totalTickets
  +int openTickets
  +int resolvedTickets
  +Map<String, Integer> ticketsByCategory
  +Map<String, Integer> ticketsByPriority
  +double averageResponseTime
  +double averageResolutionTime
}

class SentimentReport {
  +double positiveRatio
  +double neutralRatio
  +double negativeRatio
}

class ChatbotReport {
  +int totalInteractions
  +int successfulAutomations
  +int escalationsToHuman
}

' ======================
' Relationships
' ======================

User "1" -- "0..*" Ticket : creates >
User "1" -- "0..*" Ticket : assigned as agent >

Ticket "1" -- "0..*" Message : has >
User "1" -- "0..*" Message : sends >

User "1" -- "0..*" KnowledgeBaseEntry : updates >

User "1" -- "0..*" SystemLog : triggers >
Ticket "1" -- "0..*" SystemLog : associated >

' NEW: Notification relationships
NotificationService --> User
NotificationService --> Ticket
TicketService --> NotificationService : uses >

' Services use domain classes
AuthService --> User
TicketService --> Ticket
TicketService --> Message
ChatbotService --> Message
ChatbotService --> Ticket
KnowledgeBaseService --> KnowledgeBaseEntry
AnalyticsService --> TicketStatistics
AnalyticsService --> SentimentReport
AnalyticsService --> ChatbotReport
AnalyticsService --> Ticket
AnalyticsService --> Message
SystemLogService --> SystemLog

@enduml
