# ==========================================================
# AI-Based Customer Support Automation System
# Single environment configuration file
# ==========================================================

# ---------- Application ----------
# General Spring Boot runtime settings used for local development.
SERVER_PORT=8080
SERVER_ERROR_INCLUDE_MESSAGE=always
APP_DB_MODE=h2
SHOW_SQL=false
JPA_DDL_AUTO=update
SEED_DATA=true
ACTUATOR_ENDPOINTS=health,info

# ---------- Local H2 database ----------
# H2 is the default lightweight database so the backend can run without a separate server.
# Used when APP_DB_MODE=h2. This lets `mvn spring-boot:run` work without MySQL.
H2_DB_URL=jdbc:h2:file:./data/supportdb;MODE=MySQL;DATABASE_TO_LOWER=TRUE;AUTO_SERVER=TRUE
H2_DB_USERNAME=sa
H2_DB_PASSWORD=
H2_CONSOLE_ENABLED=true

# ---------- MySQL database ----------
# These values are used when the MySQL profile is selected, including Docker development.
# Used when APP_DB_MODE=mysql.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=ai_customer_support
MYSQL_USER=support
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_CREATE_DATABASE=true
MYSQL_USE_SSL=false
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_SERVER_TIMEZONE=UTC

# Docker uses the same .env file, but these two values let Docker use
# MySQL while normal local Maven development can remain on H2.
DOCKER_DB_MODE=mysql
DOCKER_MYSQL_HOST=mysql
MYSQL_EXPOSED_PORT=3306

# ---------- JWT authentication ----------
# JWT settings control token signing and how long a login token remains valid.
# Replace before deployment. Keep this long/random and do not commit the real value.
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-before-deployment-123456789
JWT_EXPIRATION_MINUTES=480

# ---------- Frontend / CORS ----------
# Only the listed frontend origins are allowed to call the backend from a browser.
# Comma-separated list; do not put spaces unless they are part of an origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# ---------- AI / OpenAI ----------
# Select the local rules or OpenAI provider and configure the external API connection here.
# local = no external API required
# openai = use OpenAI for the full AI analysis first, then local fallback on failure
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CONNECT_TIMEOUT_SECONDS=8
OPENAI_REQUEST_TIMEOUT_SECONDS=25
