# Browser API base URL. Recommended: leave blank and use the proxy settings below.
VITE_API_BASE_URL=
VITE_API_PROXY_TARGET=http://127.0.0.1:8080
VITE_API_TIMEOUT_MS=30000
VITE_ENABLE_DEMO_ACCOUNTS=false

# Docker/Nginx backend target. Change this to the backend container/service URL in deployment.
BACKEND_API_URL=http://backend:8080

# Frontend public URL and the value normally shared with the backend CORS configuration.
FRONTEND_PUBLIC_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081

FRONTEND_PORT=8081
