# ==========================================================
# Full-stack Docker Compose environment example
# Copy this file to .env before running docker compose.
# ==========================================================

# ---------- Frontend container ----------
FRONTEND_PORT=8081
VITE_API_BASE_URL=
VITE_API_TIMEOUT_MS=30000
VITE_ENABLE_DEMO_ACCOUNTS=false
BACKEND_API_URL=http://backend:8080

# ---------- Backend container ----------
SERVER_PORT=8080
SERVER_ERROR_INCLUDE_MESSAGE=always
APP_DB_MODE=mysql
SHOW_SQL=false
JPA_DDL_AUTO=update
SEED_DATA=true
ACTUATOR_ENDPOINTS=health,info
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# ---------- MySQL container ----------
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=ai_customer_support
MYSQL_USER=support
MYSQL_PASSWORD=change-this-db-password
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_CREATE_DATABASE=true
MYSQL_SSL_MODE=DISABLED
MYSQL_ALLOW_PUBLIC_KEY_RETRIEVAL=true
MYSQL_SERVER_TIMEZONE=UTC
MYSQL_EXPOSED_PORT=3306

# ---------- JWT ----------
JWT_SECRET=replace-with-a-random-secret-at-least-64-characters-long-before-deployment-123456789
JWT_EXPIRATION_MINUTES=480

# ---------- AI / OpenAI ----------
AI_PROVIDER=local
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_ENDPOINT=https://api.openai.com/v1/responses
OPENAI_CONNECT_TIMEOUT_SECONDS=8
OPENAI_REQUEST_TIMEOUT_SECONDS=25
